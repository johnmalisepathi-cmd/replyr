# Copy these into Vercel → Project → Settings → Environment Variables.

# Your Claude API key (from platform.claude.com → API keys). Server-only: never put it in a VITE_ variable.
ANTHROPIC_API_KEY=

# Tells the website to use the AI server in api/ai.js.
VITE_AI_ENDPOINT=/api/ai

# Where early-access sign-ups are sent, e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx
VITE_WAITLIST_ENDPOINT=

# Shown in the footer, e.g. hello@varadiq.com
VITE_CONTACT_EMAIL=
